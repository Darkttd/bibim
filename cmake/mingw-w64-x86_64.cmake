# Cross-compiles for 64-bit Windows with MinGW-w64 from Linux:
#   cmake -S . -B build-mingw -DCMAKE_TOOLCHAIN_FILE=cmake/mingw-w64-x86_64.cmake
# Tests then run under Wine (CMAKE_CROSSCOMPILING_EMULATOR) when it is found.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

set(BIBIM_MINGW_PREFIX x86_64-w64-mingw32)
set(CMAKE_C_COMPILER ${BIBIM_MINGW_PREFIX}-gcc)
set(CMAKE_CXX_COMPILER ${BIBIM_MINGW_PREFIX}-g++)
set(CMAKE_RC_COMPILER ${BIBIM_MINGW_PREFIX}-windres)

set(CMAKE_FIND_ROOT_PATH /usr/${BIBIM_MINGW_PREFIX})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

find_program(BIBIM_WINE wine)
if(BIBIM_WINE)
    set(CMAKE_CROSSCOMPILING_EMULATOR ${BIBIM_WINE})
endif()
